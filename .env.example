# Copie para .env (NUNCA versione o .env). Valores abaixo são de exemplo.

# ---------- Front (apps/web) ----------
# Cidade usada quando o host não identifica nenhuma (ex.: localhost:3000).
DEFAULT_TENANT=cianorte
# Liga botões de demonstração ("Simular pagamento", "Simular aprovação") e /dev/tokens.
# Em produção: false.
NEXT_PUBLIC_DEMO_MODE=true
# URL pública da API. Vazio = front usa os mocks de src/mocks.
NEXT_PUBLIC_API_URL=
# URL interna da API para chamadas do servidor Next dentro da rede Docker.
API_URL=

# ---------- Proxy (Caddy) ----------
# Domínios servidos. Cada cidade tem o seu; HTTPS automático.
DOMINIOS_WEB=cianortetem.com.br, www.cianortetem.com.br
EMAIL_ACME=ti@exemplo.com.br

# ---------- Back-end (fase 2: apps/api, NestJS) ----------
POSTGRES_DB=cianorte_tem
POSTGRES_USER=cianorte_tem
POSTGRES_PASSWORD=troque-por-uma-senha-forte
DATABASE_URL=postgresql://cianorte_tem:troque-por-uma-senha-forte@db:5432/cianorte_tem
